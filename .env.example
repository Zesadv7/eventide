# Preferred provider-neutral configuration.
# Supported values: anthropic, openai_compatible, openai_responses
EVENTIDE_PROVIDER=openai_compatible
EVENTIDE_API_KEY=replace-me
EVENTIDE_BASE_URL=https://your-provider.example/v1
EVENTIDE_MODEL=replace-with-a-tool-capable-model

# Workspace knowledge retrieval (optional; defaults to deterministic local hash vectors).
# EVENTIDE_EMBEDDING_PROVIDER=hash
# EVENTIDE_EMBEDDING_DIM=256
# For semantic vectors, use an OpenAI-compatible embedding endpoint:
# EVENTIDE_EMBEDDING_PROVIDER=openai_compatible
# EVENTIDE_EMBEDDING_MODEL=replace-with-an-embedding-model
# EVENTIDE_EMBEDDING_BASE_URL=https://your-provider.example/v1
# EVENTIDE_EMBEDDING_API_KEY=replace-me
# If EVENTIDE_EMBEDDING_API_KEY is omitted, EVENTIDE_API_KEY is used.

# Runtime tuning (optional)
# EVENTIDE_MAX_TOKENS=8000
# EVENTIDE_MAX_STEPS=30
# EVENTIDE_CONTEXT_LIMIT=50000
# EVENTIDE_APPROVAL_TIMEOUT=60
# Default: per-user state directory (Windows: %LOCALAPPDATA%\Eventide).
# Relative overrides resolve against the startup working directory.
# EVENTIDE_STATE_DIR=.eventide
# Use one stable Fernet key for encrypted provider credentials in Docker/server installs.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# EVENTIDE_SECRET_KEY=replace-with-a-stable-fernet-key

# Legacy Anthropic aliases remain supported during migration:
# ANTHROPIC_API_KEY=replace-me
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MODEL_ID=replace-with-model-id

# Provider model IDs and URLs change over time. Copy current values from the
# provider's official documentation instead of relying on examples in source.
