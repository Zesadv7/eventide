# Preferred provider-neutral configuration.
# Supported values: anthropic, openai_compatible
NEXUS_PROVIDER=openai_compatible
NEXUS_API_KEY=replace-me
NEXUS_BASE_URL=https://your-provider.example/v1
NEXUS_MODEL=replace-with-a-tool-capable-model

# Runtime tuning (optional)
# NEXUS_MAX_TOKENS=8000
# NEXUS_MAX_STEPS=30
# NEXUS_CONTEXT_LIMIT=50000
# NEXUS_APPROVAL_TIMEOUT=60
# NEXUS_STATE_DIR=.nexus

# Legacy Anthropic aliases remain supported during migration:
# ANTHROPIC_API_KEY=replace-me
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MODEL_ID=replace-with-model-id

# Provider model IDs and URLs change over time. Copy current values from the
# provider's official documentation instead of relying on examples in source.
