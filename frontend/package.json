{
  "name": "eventide-workbench",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/package_web.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run_e2e.mjs",
    "api:generate": "python3 scripts/export_openapi.py && openapi-typescript openapi.json -o src/api/schema.d.ts && prettier --write openapi.json src/api/schema.d.ts",
    "format": "prettier --write src tests *.ts *.json index.html scripts/*.mjs",
    "format:check": "prettier --check src tests *.ts *.json index.html scripts/*.mjs"
  },
  "dependencies": {
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
